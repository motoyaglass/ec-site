# Railway PostgreSQL(Railwayプロジェクトに Postgres プラグインを追加すると自動で発行される)
DATABASE_URL=postgresql://user:password@host:port/railway

# Stripe (Developers > API keys で取得。本番は sk_live_、テストは sk_test_)
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# Stripe Webhook(Developers > Webhooks でエンドポイント作成後に取得。ローカルはStripe CLIで取得)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# 管理ページのログインパスワード(自分で決める)
ADMIN_PASSWORD=your-strong-password
# ログインセッション用の任意のランダム文字列(自分で決める。パスワードとは別の値にする)
ADMIN_SESSION_SECRET=some-random-long-string

# Cloudflare Turnstile(管理ページログインのボット対策、任意)
# https://dash.cloudflare.com/ の「Turnstile」でウィジェットを作成して取得
# 未設定のままでもログイン機能は通常通り使えます(Turnstileチェックが省略されるだけ)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# サイトの公開URL(デプロイ後のURLに変更。ローカル確認時は http://localhost:3000 のままでOK)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 商品画像のアップロード先ディレクトリ(任意)。
# Railwayではコンテナ再デプロイ時にファイルが消えないよう、Volumeをマウントしてそのパスを指定してください(例: /data/uploads)。
# 未設定の場合はプロジェクト内の .uploads フォルダに保存されます(ローカル確認用)。
UPLOAD_DIR=
